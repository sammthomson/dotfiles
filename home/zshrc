# zmodload zsh/zprof  # for profiling slow startup

brew_command="${commands[brew]:-}"
if [[ -z "$brew_command" ]]; then
  for candidate in /opt/homebrew/bin/brew /usr/local/bin/brew /usr/local/Homebrew/bin/brew; do
    if [[ -x "$candidate" ]]; then
      brew_command="$candidate"
      break
    fi
  done
fi
if [[ -n "$brew_command" ]]; then
  eval "$("$brew_command" shellenv)"
fi
unset brew_command candidate

# Source every file in ~/.zsh.d/
for f in "$HOME"/.zsh.d/*(.N); do
  source "$f"
done

