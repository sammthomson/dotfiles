autoload -Uz compinit
compinit

if (( $+commands[brew] )); then
  antidote_profile="$(brew --prefix antidote 2>/dev/null)/share/antidote/antidote.zsh"
  if [[ -r "$antidote_profile" ]]; then
    source "$antidote_profile"
    antidote load
  fi
  unset antidote_profile
fi

autoload -Uz promptinit && promptinit
if [[ " ${prompt_themes[*]} " == *" pure "* ]]; then
  prompt pure
fi


