# zmodload zsh/zprof  # Enable with the final zprof call when profiling startup.

export HOMEBREW_NO_ANALYTICS=1

if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

dotfiles_root="${${(%):-%N}:A:h:h}"

for file in "$dotfiles_root"/home/zsh.d/*(.N); do
  source "$file"
done

autoload -Uz compinit
compinit

if (( $+commands[brew] )); then
  antidote_profile="$(brew --prefix antidote 2>/dev/null)/share/antidote/antidote.zsh"
  if [[ -r "$antidote_profile" ]]; then
    source "$antidote_profile"
    if [[ "$OSTYPE" == darwin* ]]; then
      antidote_cache_dir="${XDG_CACHE_HOME:-$HOME/Library/Caches}/antidote"
    else
      antidote_cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/antidote"
    fi
    zstyle ':antidote:static' file "$antidote_cache_dir/zsh_plugins.zsh"
    antidote load "$dotfiles_root/home/zsh_plugins.txt"
  fi
  unset antidote_profile antidote_cache_dir
fi

autoload -Uz promptinit && promptinit
if [[ " ${prompt_themes[*]} " == *" pure "* ]]; then
  prompt pure
fi

if (( $+commands[mise] )); then
  eval "$(mise activate zsh)"
fi

unset dotfiles_root file

# zprof
